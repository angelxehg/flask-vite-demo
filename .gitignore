# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Tool caches. Each of these writes a self-ignoring .gitignore of its own, so
# they stay out of a commit either way -- but only by accident of the tool.
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv

# Node
node_modules/

# macOS
.DS_Store

# Agent config symlinks -- recreate with scripts/setup-agents.sh
# The real files are AGENTS.md, skills/, and docs/; these are just aliases to them.
/CLAUDE.md
/.claude/skills
/.codex/skills
/.junie/guidelines.md
/.junie/skills
